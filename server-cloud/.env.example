# server-cloud configuration — copy to /etc/higoos/cloud.env for systemd.
# Dev defaults let it boot with zero setup (memory store, dev SMS/oauth stubs).

# --- Core ---
HIGO_CLOUD_ENV=production
HIGO_CLOUD_HTTP_ADDR=:8090
HIGO_CLOUD_VERSION=dev
# CORS allow-origin for the website/console; "*" allows any (dev only).
HIGO_CLOUD_PUBLIC_ORIGIN=*

# --- Storage ---
# memory (dev, lost on restart) | postgres (production; M5)
HIGO_CLOUD_STORE=memory
# HIGO_CLOUD_DB_DSN=postgres://user:pass@127.0.0.1:5432/higocloud?sslmode=disable

# --- Auth / tokens ---
# Enforce a valid cloud access token on guarded routes (auto-on outside dev).
HIGO_CLOUD_AUTH_REQUIRED=true
# Stable secret so cloud access tokens survive restarts (set a long random value).
HIGO_CLOUD_JWT_SECRET=
HIGO_CLOUD_ACCESS_TTL=15m
HIGO_CLOUD_REFRESH_TTL=1440h
# 64 hex chars (Ed25519 seed): fixes the cloud public key distributed to every
# NAS at registration. MUST be stable in production — rotating it invalidates all
# previously distributed device-token trust. Generate: openssl rand -hex 32
HIGO_CLOUD_DEVICE_TOKEN_SEED=
HIGO_CLOUD_DEVICE_TOKEN_TTL=10m

# --- Binding / verification ---
HIGO_CLOUD_PAIRING_TTL=5m
HIGO_CLOUD_VERIFICATION_TTL=5m
# Echo SMS/email codes in the API response — dev only, never in production.
HIGO_CLOUD_VERIFICATION_DEBUG=false

# --- External providers (empty keeps dev stubs; production must fill) ---
HIGO_CLOUD_APPLE_CLIENT_ID=com.hiveton.higoos
HIGO_CLOUD_WECHAT_APPID=
HIGO_CLOUD_WECHAT_SECRET=
HIGO_CLOUD_APNS_BUNDLE_ID=com.hiveton.higoos
HIGO_CLOUD_APNS_KEY_ID=
HIGO_CLOUD_APNS_TEAM_ID=
HIGO_CLOUD_APNS_KEY_PATH=/etc/higoos/apns.p8
