HIGO_APP_NAME=HiGoOS
HIGO_ENV=dev
HIGO_VERSION=dev
HIGO_HTTP_ADDR=:8080
HIGO_PUBLIC_ORIGIN=http://localhost:5173
HIGO_STATE_DIR=

# --- Authentication / user center ---
# Enforce a valid session for /api/v1/* even in dev/test (defaults: dev/test=false, otherwise=true).
HIGO_AUTH_REQUIRED=false
# Server-side session / higo_session cookie lifetime.
HIGO_SESSION_TTL=720h
# SameSite attribute for auth cookies: lax | strict | none (use none for cross-site HTTPS).
HIGO_COOKIE_SAMESITE=lax
# Disable CSRF (X-CSRF-Token must match higo_csrf cookie) for cookie-session writes (defaults: dev/test=true, otherwise=false).
HIGO_CSRF_DISABLED=true
# Accounts backend: system (Linux users) | devstub (credentials.json) | empty = auto by OS.
HIGO_ACCOUNTS_BACKEND=
# Minimum UID for HiGoOS-managed system users.
HIGO_ACCOUNTS_UID_BASE=3000
# Primary group for managed users.
HIGO_ACCOUNTS_GROUP=higoos
# Membership in this group grants the admin role.
HIGO_ACCOUNTS_ADMIN_GROUP=higoos-admins
# Lock an account after this many consecutive failed logins.
HIGO_LOGIN_MAX_FAILURES=5
# Fix the first-start admin password (empty = generate a random one and log it once).
HIGO_ADMIN_BOOTSTRAP_PASSWORD=

# --- Face model / self-training framework (global AI photo analysis) ---------
# HTTP endpoint of a cross-arch (x86_64 + arm64) face detection+embedding sidecar
# — an off-the-shelf ONNX model (ArcFace/SFace) or a self-trained model. It takes
# {image,mime} and returns {faces:[{box,score,embedding}]}. Empty = fall back to
# the built-in vision-descriptor approximation (no model needed).
HIGO_FACE_EMBEDDER_URL=
# HTTP endpoint of a self-training sidecar that consumes the exported labeled
# face dataset ({samples:[...]}) and returns a new model version. Empty leaves
# the self-training framework reserved but inert (retrain is a no-op).
HIGO_FACE_TRAINER_URL=
