{
  "schemaVersion": "1",
  "id": "paperless",
  "name": "Paperless-ngx",
  "version": "2.16.1",
  "category": "文档归档",
  "description": "发票、合同和保修单 OCR 归档，可写入文件管理标签。",
  "author": { "name": "Paperless-ngx", "url": "https://docs.paperless-ngx.com" },
  "risk": "medium",
  "source": "community",
  "containers": [
    {
      "name": "paperless",
      "image": "ghcr.io/paperless-ngx/paperless-ngx:latest",
      "ports": [{ "container": 8000, "protocol": "tcp" }],
      "volumes": [
        { "name": "paperless-data", "path": "/usr/src/paperless/data" },
        { "name": "paperless-media", "path": "/usr/src/paperless/media" }
      ],
      "env": [
        { "key": "PAPERLESS_SECRET_KEY", "value": "{{config.secretKey}}" },
        { "key": "PAPERLESS_OCR_LANGUAGE", "value": "{{config.ocrLanguage}}" }
      ],
      "resources": { "cpu": 2, "memoryMb": 1536 },
      "restartPolicy": "unless-stopped"
    }
  ],
  "webEntry": { "container": "paperless", "port": 8000, "path": "/", "display": "embed" },
  "permissions": ["files.write", "storage.write"],
  "config": [
    { "key": "secretKey", "label": "密钥 (Secret Key)", "type": "password", "required": true, "secret": true },
    { "key": "ocrLanguage", "label": "OCR 语言", "type": "text", "default": "chi_sim+eng" }
  ]
}
