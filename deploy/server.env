HIGO_APP_NAME=HiGoOS
HIGO_ENV=dev
HIGO_VERSION=dev
HIGO_HTTP_ADDR=0.0.0.0:8080
HIGO_PUBLIC_ORIGIN=*
HIGO_STATE_DIR=/var/lib/higoos/state
HIGO_NAS_ROOT=/srv/higoos/nas
HIGO_STATIC_DIR=/opt/higoos/web
HIGO_DATABASE_URL=postgres://higo:higo@127.0.0.1:5433/higo?sslmode=disable

# --- Authentication / user center ---
# NOTE: HIGO_ENV is kept at dev above, which means sessionGuard is bypassed (no real auth).
# For production, set HIGO_ENV=production AND the following:
#   HIGO_AUTH_REQUIRED=true        # require a valid higo_session for /api/v1/*
#   HIGO_CSRF_DISABLED=false       # enforce X-CSRF-Token == higo_csrf on cookie-session writes
#   HIGO_COOKIE_SAMESITE=none      # only if UI and API are cross-site over HTTPS (otherwise lax)
# These take their production defaults automatically once HIGO_ENV is not dev/test, but pin them
# explicitly when going live. higo-api must run as root (deploy unit already sets User=root) to
# manage Linux system users and read /etc/shadow.

# Enforce a valid session even in dev (defaults: dev/test=false, otherwise=true).
HIGO_AUTH_REQUIRED=false
# Server-side session / higo_session cookie lifetime.
HIGO_SESSION_TTL=720h
# SameSite for auth cookies: lax | strict | none (none for cross-site HTTPS).
HIGO_COOKIE_SAMESITE=lax
# Disable CSRF for cookie-session writes (defaults: dev/test=true, otherwise=false).
HIGO_CSRF_DISABLED=true
# Accounts backend: system (Linux users) | devstub | empty = auto by OS.
HIGO_ACCOUNTS_BACKEND=
# Minimum UID for HiGoOS-managed system users.
HIGO_ACCOUNTS_UID_BASE=3000
# Primary group for managed users.
HIGO_ACCOUNTS_GROUP=higoos
# Membership in this group grants the admin role.
HIGO_ACCOUNTS_ADMIN_GROUP=higoos-admins
# Lock an account after this many consecutive failed logins.
HIGO_LOGIN_MAX_FAILURES=5
# Fix the first-start admin password (empty = generate a random one and log it once).
HIGO_ADMIN_BOOTSTRAP_PASSWORD=
