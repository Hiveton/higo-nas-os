HIGO_APP_NAME=HiGoOS
HIGO_ENV=production
HIGO_VERSION=dev
HIGO_HTTP_ADDR=0.0.0.0:8080
HIGO_PUBLIC_ORIGIN=*
HIGO_STATE_DIR=/var/lib/higoos/state
HIGO_NAS_ROOT=/srv/higoos/nas
HIGO_STATIC_DIR=/opt/higoos/web
HIGO_DATABASE_URL=postgres://higo:higo@127.0.0.1:5433/higo?sslmode=disable

# --- AI analysis / models -----------------------------------------------------
# 对话/视觉/向量/语音 模型在应用内「系统设置 → 模型策略」配置（持久化到
# <state>/llm_providers.json），不走 env。未配置时 standard/deep 分析会降级为仅
# 文件名+扩展名；语义检索在未配置向量模型或数据库时回退到关键字匹配。
# 人脸识别 / 自训练 sidecar（可选，跨架构 x86_64+arm64）。留空则人脸聚类退化为
# 视觉描述近似、自训练为 no-op。详见 server-go/.env.example。
HIGO_FACE_EMBEDDER_URL=
HIGO_FACE_TRAINER_URL=
# 可选：开箱即用的默认 LLM provider（通常指向本机 Ollama 等 OpenAI 兼容端点，免 key）。
# 仅在尚未配置任何 provider 时生效，应用内修改始终优先。留空 BASE_URL/CHAT_MODEL 则不播种。
# 例：HIGO_LLM_DEFAULT_BASE_URL=http://127.0.0.1:11434/v1  HIGO_LLM_DEFAULT_CHAT_MODEL=qwen2.5:7b
HIGO_LLM_DEFAULT_BASE_URL=
HIGO_LLM_DEFAULT_API_KEY=
HIGO_LLM_DEFAULT_CHAT_MODEL=
HIGO_LLM_DEFAULT_VISION_MODEL=
HIGO_LLM_DEFAULT_EMBED_MODEL=
HIGO_LLM_DEFAULT_ASR_MODEL=

# --- Authentication / user center ---
# AUTH IS NOW ENFORCED (HIGO_ENV=production above). sessionGuard requires a valid
# higo_session cookie (or the cloud device token, or the HIGO_API_TOKEN below) on
# every /api/v1/* and /mcp request; CSRF double-submit is enforced on cookie writes.
# Log in at the desktop with the bootstrap admin (below) or any Linux user in the
# higoos-admins group. higo-api runs as root (deploy unit sets User=root) to read
# /etc/shadow and manage Linux users.
#
# ⚠️ The two secrets below are DEV-USABLE defaults for the isolated local VM
# (matching the repo's existing 10.211.55.3 hiveton/123qwe posture). CHANGE BOTH
# to strong unique values for any real/internet-facing deployment, and do NOT
# commit real secrets to git — set them in /etc/higoos/server.env on the host.

# Require a valid session for /api/v1/* (production: true).
HIGO_AUTH_REQUIRED=true
# Server-side session / higo_session cookie lifetime.
HIGO_SESSION_TTL=720h
# SameSite for auth cookies: lax | strict | none (none for cross-site HTTPS).
HIGO_COOKIE_SAMESITE=lax
# Enforce X-CSRF-Token == higo_csrf on cookie-session writes (production: false=enforced).
HIGO_CSRF_DISABLED=false
# Initial admin password (account "admin"). Empty => a random one is generated and
# printed ONCE in the boot log (journalctl -u higo-api). ⚠️ dev-VM default below.
HIGO_ADMIN_BOOTSTRAP_PASSWORD=123qwe
# Shared bearer token external API / MCP clients present as `Authorization: Bearer <token>`.
# Empty => no bearer is trusted (only cookies + cloud device tokens authenticate);
# the in-app AI assistant still works (it bypasses the guard in-process). ⚠️ dev-VM default.
HIGO_API_TOKEN=higoos-dev-token-change-me
# Accounts backend: system (Linux users) | devstub | empty = auto by OS.
HIGO_ACCOUNTS_BACKEND=
# Minimum UID for HiGoOS-managed system users.
HIGO_ACCOUNTS_UID_BASE=3000
# Primary group for managed users.
HIGO_ACCOUNTS_GROUP=higoos
# Membership in this group grants the admin role.
HIGO_ACCOUNTS_ADMIN_GROUP=higoos-admins
# Lock an account after this many consecutive failed logins.
HIGO_LOGIN_MAX_FAILURES=5
# Fix the first-start admin password (empty = generate a random one and log it once).
HIGO_ADMIN_BOOTSTRAP_PASSWORD=
